#!/usr/bin/env bash

set -euo pipefail

if [ $# -ne 2 ]; then
  echo "Usage: $0 <tex-file> <output-file>" >&2
  exit 1
fi

TEX_FILE="$(realpath "$1")"
OUTPUT_FILE="$(realpath -m "$2")"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

mkdir -p "$(dirname "$OUTPUT_FILE")"

docker build -t build-cv "$SCRIPT_DIR"
docker run --rm \
  --volume="$(dirname "$TEX_FILE"):/src:ro" \
  --volume="$(dirname "$OUTPUT_FILE"):/output" \
  build-cv \
  bash -c "
    set -e
    pdflatex -output-directory=/tmp -output-format=pdf '/src/$(basename "$TEX_FILE")'
    cp '/tmp/$(basename "$TEX_FILE" .tex).pdf' '/output/$(basename "$OUTPUT_FILE")'
  "
